        '#withRevisionHistoryLimit':: d.fn(help='', args=[d.arg(name='revisionHistoryLimit', type=d.T.integer)]),
        withRevisionHistoryLimit(revisionHistoryLimit): { spec+: { deployment+: { spec+: { revisionHistoryLimit: revisionHistoryLimit } } } },
