            '#withName':: d.fn(help='"name is the referenced service. The service must exist in\\nthe same namespace as the Ingress object."', args=[d.arg(name='name', type=d.T.string)]),
            withName(name): { spec+: { ingress+: { spec+: { defaultBackend+: { service+: { name: name } } } } } },
