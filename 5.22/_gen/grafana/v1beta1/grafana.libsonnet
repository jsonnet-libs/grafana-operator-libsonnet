    jsonnet: {
      '#libraryLabelSelector':: d.obj(help='"A label selector is a label query over a set of resources. The result of matchLabels and\\nmatchExpressions are ANDed. An empty label selector matches all objects. A null\\nlabel selector matches no objects."'),
      libraryLabelSelector: {
