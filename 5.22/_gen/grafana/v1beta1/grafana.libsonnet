        '#withRulesMixin':: d.fn(help='"rules is a list of host rules used to configure the Ingress. If unspecified,\\nor no rule matches, all traffic is sent to the default backend."\n\n**Note:** This function appends passed data to existing values', args=[d.arg(name='rules', type=d.T.array)]),
